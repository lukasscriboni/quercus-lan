{
  "name": "quercus-desktop",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Aplicacion de escritorio para la gestion gastronomica Quercus",
  "author": "Quercus",
  "main": "main.cjs",
  "build": {
    "appId": "com.quercus.gestion",
    "productName": "Quercus",
    "electronVersion": "44.1.0",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../dist-electron",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "icon.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*",
          ".pnpm/**/*",
          ".prisma/**/*"
        ]
      },
      {
        "from": "../.next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.env",
        "to": "app/.env"
      }
    ],
    "win": {
      "icon": "icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Quercus-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quercus",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
