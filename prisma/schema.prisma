generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockMode {
  NONE
  DIRECT
  RECIPE
}

enum UnitOfMeasure {
  UNIT
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum StockMovementType {
  INITIAL_IMPORT
  PURCHASE
  SALE
  ENTRY
  EXIT
  ADJUSTMENT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  INVENTORY_ADJUSTMENT
  REVERSAL
}

enum InventoryStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ImportStatus {
  ANALYZED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum ImportDuplicateMode {
  SKIP_EXISTING
  UPDATE_EXISTING
  CREATE_ONLY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  BILL_REQUESTED
  RESERVED
  DISABLED
}

enum FloorElementType {
  TABLE
  WALL
  BAR
  TEXT
  DECORATION
}

enum OrderType {
  TABLE
  COUNTER
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  READY
  BILL_REQUESTED
  PAID
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum KitchenStationType {
  BAR
  KITCHEN
  OTHER
}

enum KitchenTicketStatus {
  NEW
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  INCOME
  EXPENSE
  WITHDRAWAL
  REFUND
  CLOSING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  branches   Branch[]
  users      User[]
  roles      Role[]
  categories Category[]
  products   Product[]
  suppliers  Supplier[]
  customers  Customer[]
  auditLogs  AuditLog[]
  importJobs ImportJob[]

  @@index([name])
}

model Branch {
  id              String           @id @default(cuid())
  organizationId  String
  name            String
  address         String?
  timezone        String           @default("America/Argentina/Buenos_Aires")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses      Warehouse[]
  sectors         Sector[]
  kitchenStations KitchenStation[]
  orders          Order[]
  cashRegisters   CashRegister[]
  purchaseOrders  PurchaseOrder[]
  reservations    Reservation[]
  employees       Employee[]
  salesReports    SalesReport[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          User[]

  @@unique([organizationId, name])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id               String           @id @default(cuid())
  organizationId   String
  roleId           String
  username         String
  displayName      String
  passwordHash     String
  isActive         Boolean          @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions         Session[]
  employee         Employee?
  stockMovements   StockMovement[]
  inventoryCounts  InventoryCount[]
  importJobs       ImportJob[]
  orders           Order[]
  cashShiftsOpened CashShift[]      @relation("ShiftOpenedBy")
  cashShiftsClosed CashShift[]      @relation("ShiftClosedBy")
  cashMovements    CashMovement[]
  purchaseOrders   PurchaseOrder[]
  auditLogs        AuditLog[]
  salesReports     SalesReport[]

  @@unique([organizationId, username])
  @@index([roleId, isActive])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Employee {
  id        String   @id @default(cuid())
  branchId  String
  userId    String?  @unique
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId, isActive])
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  isActive       Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, isActive, sortOrder])
}

model Product {
  id                  String               @id @default(cuid())
  organizationId      String
  categoryId          String?
  kitchenStationId    String?
  supplierId          String?
  name                String
  normalizedName      String
  description         String?
  sku                 String?
  normalizedSku       String?
  barcode             String?
  brand               String?
  price               Decimal              @default(0) @db.Decimal(12, 2)
  cost                Decimal              @default(0) @db.Decimal(12, 2)
  taxRate             Decimal              @default(21) @db.Decimal(5, 2)
  stockMode           StockMode            @default(NONE)
  unit                UnitOfMeasure        @default(UNIT)
  isActive            Boolean              @default(true)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kitchenStation      KitchenStation?      @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stocks              Stock[]
  stockMovements      StockMovement[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseOrderItem[]
  inventoryCountItems InventoryCountItem[]
  ingredient          Ingredient?
  recipe              Recipe?

  @@unique([organizationId, sku])
  @@unique([organizationId, normalizedSku])
  @@unique([organizationId, barcode])
  @@index([organizationId, isActive, name])
  @@index([categoryId, isActive])
}

model Warehouse {
  id              String           @id @default(cuid())
  branchId        String
  name            String
  isDefault       Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stocks          Stock[]
  movements       StockMovement[]
  inventoryCounts InventoryCount[]

  @@unique([branchId, name])
  @@index([branchId, isDefault])
}

model Stock {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal   @default(0) @db.Decimal(14, 3)
  minimum     Decimal   @default(0) @db.Decimal(14, 3)
  version     Int       @default(1)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId, quantity])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  warehouseId   String
  userId        String?
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  previousQty   Decimal           @db.Decimal(14, 3)
  newQty        Decimal           @db.Decimal(14, 3)
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime          @default(now())
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
}

model InventoryCount {
  id          String               @id @default(cuid())
  warehouseId String
  userId      String
  status      InventoryStatus      @default(DRAFT)
  notes       String?
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       InventoryCountItem[]

  @@index([warehouseId, status, startedAt])
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  productId        String
  systemQuantity   Decimal        @db.Decimal(14, 3)
  stockVersion     Int
  countedQuantity  Decimal?       @db.Decimal(14, 3)
  difference       Decimal?       @db.Decimal(14, 3)
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([inventoryCountId, productId])
}

model ImportJob {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  fileName       String
  type           String              @default("PRODUCTS")
  duplicateMode  ImportDuplicateMode
  totalRows      Int
  createdRows    Int                 @default(0)
  updatedRows    Int                 @default(0)
  skippedRows    Int                 @default(0)
  failedRows     Int                 @default(0)
  status         ImportStatus        @default(ANALYZED)
  mapping        Json
  createdAt      DateTime            @default(now())
  completedAt    DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  errors         ImportError[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model ImportError {
  id          String    @id @default(cuid())
  importJobId String
  rowNumber   Int
  message     String
  rawData     Json?
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, rowNumber])
}

model Sector {
  id        String         @id @default(cuid())
  branchId  String
  name      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables    DiningTable[]
  elements  FloorElement[]

  @@unique([branchId, name])
}

model DiningTable {
  id           String        @id @default(cuid())
  sectorId     String
  name         String
  capacity     Int           @default(4)
  status       TableStatus   @default(AVAILABLE)
  x            Decimal       @default(0) @db.Decimal(9, 2)
  y            Decimal       @default(0) @db.Decimal(9, 2)
  width        Decimal       @default(100) @db.Decimal(9, 2)
  height       Decimal       @default(100) @db.Decimal(9, 2)
  rotation     Decimal       @default(0) @db.Decimal(6, 2)
  shape        String        @default("ROUND")
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sector       Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([sectorId, name])
  @@index([sectorId, status])
}

model FloorElement {
  id       String           @id @default(cuid())
  sectorId String
  type     FloorElementType
  label    String?
  x        Decimal          @db.Decimal(9, 2)
  y        Decimal          @db.Decimal(9, 2)
  width    Decimal          @db.Decimal(9, 2)
  height   Decimal          @db.Decimal(9, 2)
  rotation Decimal          @default(0) @db.Decimal(6, 2)
  style    Json?
  version  Int              @default(1)
  sector   Sector           @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([sectorId, type])
}

model Order {
  id             String          @id @default(cuid())
  branchId       String
  diningTableId  String?
  customerId     String?
  openedById     String
  number         Int
  type           OrderType
  status         OrderStatus     @default(OPEN)
  guestCount     Int             @default(1)
  subtotal       Decimal         @default(0) @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  tax            Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notes          String?
  version        Int             @default(1)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable    DiningTable?    @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  openedBy       User            @relation(fields: [openedById], references: [id], onDelete: Restrict)
  items          OrderItem[]
  kitchenTickets KitchenTicket[]
  payments       Payment[]

  @@unique([branchId, number])
  @@index([branchId, status, openedAt])
  @@index([diningTableId, status])
}

model OrderItem {
  id               String              @id @default(cuid())
  orderId          String
  productId        String
  kitchenStationId String?
  nameSnapshot     String
  quantity         Decimal             @db.Decimal(10, 3)
  unitPrice        Decimal             @db.Decimal(12, 2)
  costSnapshot     Decimal             @default(0) @db.Decimal(12, 2)
  discount         Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  status           OrderItemStatus     @default(PENDING)
  notes            String?
  version          Int                 @default(1)
  createdAt        DateTime            @default(now())
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  kitchenStation   KitchenStation?     @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  modifiers        OrderItemModifier[]
  ticketItems      KitchenTicketItem[]

  @@index([orderId, status])
  @@index([kitchenStationId, status])
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  name        String
  price       Decimal   @default(0) @db.Decimal(12, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model KitchenStation {
  id         String             @id @default(cuid())
  branchId   String
  name       String
  type       KitchenStationType
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
  tickets    KitchenTicket[]

  @@unique([branchId, name])
}

model KitchenTicket {
  id               String              @id @default(cuid())
  orderId          String
  kitchenStationId String
  number           Int
  status           KitchenTicketStatus @default(NEW)
  version          Int                 @default(1)
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  readyAt          DateTime?
  deliveredAt      DateTime?
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenStation   KitchenStation      @relation(fields: [kitchenStationId], references: [id], onDelete: Restrict)
  items            KitchenTicketItem[]

  @@index([kitchenStationId, status, createdAt])
}

model KitchenTicketItem {
  id              String        @id @default(cuid())
  kitchenTicketId String
  orderItemId     String
  quantity        Decimal       @db.Decimal(10, 3)
  kitchenTicket   KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([kitchenTicketId, orderItemId])
}

model Ingredient {
  id        String             @id @default(cuid())
  productId String             @unique
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipes   RecipeIngredient[]
}

model Recipe {
  id           String             @id @default(cuid())
  productId    String             @unique
  yield        Decimal            @default(1) @db.Decimal(10, 3)
  instructions String?
  version      Int                @default(1)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     Decimal       @db.Decimal(14, 3)
  unit         UnitOfMeasure
  recipe       Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
}

model CashRegister {
  id       String      @id @default(cuid())
  branchId String
  name     String
  isActive Boolean     @default(true)
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts   CashShift[]

  @@unique([branchId, name])
}

model CashShift {
  id                    String          @id @default(cuid())
  cashRegisterId        String
  openedById            String
  closedById            String?
  status                CashShiftStatus @default(OPEN)
  openingAmount         Decimal         @db.Decimal(12, 2)
  closingAmount         Decimal?        @db.Decimal(12, 2)
  expectedAmount        Decimal?        @db.Decimal(12, 2)
  difference            Decimal?        @db.Decimal(12, 2)
  virtualClosingAmount  Decimal?        @db.Decimal(12, 2)
  virtualExpectedAmount Decimal?        @db.Decimal(12, 2)
  virtualDifference     Decimal?        @db.Decimal(12, 2)
  totalDifference       Decimal?        @db.Decimal(12, 2)
  openedAt              DateTime        @default(now())
  closedAt              DateTime?
  version               Int             @default(1)
  cashRegister          CashRegister    @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  openedBy              User            @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy              User?           @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  movements             CashMovement[]
  payments              Payment[]
  salesReport           SalesReport?

  @@index([cashRegisterId, status, openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  cashShiftId String
  userId      String
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  reason      String
  referenceId String?
  createdAt   DateTime         @default(now())
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cashShiftId, createdAt])
}

model PaymentMethod {
  id       String    @id @default(cuid())
  name     String    @unique
  isActive Boolean   @default(true)
  payments Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  cashShiftId     String
  paymentMethodId String
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(COMPLETED)
  reference       String?
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashShift       CashShift     @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([cashShiftId, createdAt])
}

model SalesReport {
  id                String    @id @default(cuid())
  branchId          String
  cashShiftId       String    @unique
  createdById       String
  periodStart       DateTime
  periodEnd         DateTime
  cashTotal         Decimal   @db.Decimal(12, 2)
  virtualTotal      Decimal   @db.Decimal(12, 2)
  grandTotal        Decimal   @db.Decimal(12, 2)
  expectedCash      Decimal?  @db.Decimal(12, 2)
  declaredCash      Decimal?  @db.Decimal(12, 2)
  declaredVirtual   Decimal?  @db.Decimal(12, 2)
  cashDifference    Decimal?  @db.Decimal(12, 2)
  virtualDifference Decimal?  @db.Decimal(12, 2)
  totalDifference   Decimal?  @db.Decimal(12, 2)
  saleCount         Int
  sales             Json
  createdAt         DateTime  @default(now())
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashShift         CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId, periodEnd])
  @@index([createdAt])
}

model Supplier {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  taxId          String?
  contactName    String?
  phone          String?
  email          String?
  isActive       Boolean         @default(true)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  products       Product[]

  @@unique([organizationId, normalizedName])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  branchId    String
  supplierId  String
  createdById String
  number      Int
  status      PurchaseOrderStatus @default(DRAFT)
  total       Decimal             @default(0) @db.Decimal(12, 2)
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime            @default(now())
  version     Int                 @default(1)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]

  @@unique([branchId, number])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(14, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  unitCost        Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
}

model Customer {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses      CustomerAddress[]
  orders         Order[]
  reservations   Reservation[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String
  address    String
  notes      String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Reservation {
  id            String            @id @default(cuid())
  branchId      String
  diningTableId String?
  customerId    String
  status        ReservationStatus @default(PENDING)
  partySize     Int
  reservedFor   DateTime
  notes         String?
  createdAt     DateTime          @default(now())
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  diningTable   DiningTable?      @relation(fields: [diningTableId], references: [id], onDelete: SetNull)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([branchId, reservedFor, status])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
