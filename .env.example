# PostgreSQL queda accesible solamente desde la PC servidor.
DATABASE_URL="postgresql://quercus_app:CAMBIAR_PASSWORD@localhost:5432/quercus?schema=public"

# Cambiar por al menos 32 caracteres aleatorios antes de usar en producción.
SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_LARGO_DE_32_CARACTERES"

APP_NAME="Quercus"
PORT="3000"
BACKUP_DIR="C:\\BarSystem\\backups"
SESSION_HOURS="12"
